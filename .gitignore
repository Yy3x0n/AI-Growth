# ---------------- 环境与密钥（绝不入库） ----------------
.venv/
.env
.env.*
!.env.example

# ---------------- Python ----------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# ---------------- macOS ----------------
.DS_Store
._*

# ---------------- 数据层：许可未明示，一律不进库 ----------------
# 原始数据通过 scripts/download_data.py 重建，来源与校验和记录在 docs/data_manifest.md
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/simulated/*
# A/B 实验明细体积小（约 250KB），且是模块 D 的交付物，允许入库；
# AI 请求日志（约 6MB）由 scripts/simulate_data.py 用固定种子重建，不入库。
!data/simulated/ab_test_simulated.csv
!data/simulated/.gitkeep
data/chroma/

# ---------------- 产物层：只放行小体积聚合结果 ----------------
outputs/*
!outputs/tables
!outputs/reports
!outputs/simulated
!outputs/rag_eval_results.csv
outputs/tables/*
!outputs/tables/*.csv
!outputs/tables/.gitkeep
outputs/reports/*
!outputs/reports/*.md
outputs/simulated/*
!outputs/simulated/*.csv

# 看板与图表属于「给人看」的交付物，放行：
# 审查者不必先跑一遍代码就能看到结果，这对公开仓库的可用性影响很大。
# 体积约 0.9 MB（6 张 PNG + 1 个内嵌图片的 HTML），可接受。
!outputs/dashboard.html
!outputs/dashboard_static.html
!outputs/figures/
!outputs/figures/*.png

# ---------------- 其他 ----------------
*.log
.cache/
.DS_Store?
