# ================= LLM：智谱 GLM（当前默认） =================
# 免费额度即可跑通本项目。密钥获取：https://open.bigmodel.cn → API 密钥管理。
# provider 可选：glm（默认）/ deepseek / mock（不联网，固定返回结构化假文本）。
LLM_PROVIDER=glm
GLM_API_KEY=replace_with_your_glm_key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 实测对比（2026-11-02）：
#   glm-4-flash    1.9s  无思维链  ← 默认，快且 JSON 稳定
#   glm-4.5-flash  18.8s 带思维链  文笔更好
#   glm-5.3-flash  6.8s  带思维链  能力更强
GLM_MODEL=glm-4-flash

LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ================= LLM：DeepSeek（备选，默认不启用） =================
# 切换方式：把上面的 LLM_PROVIDER 改成 deepseek，并填这里的 KEY。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ================= 数据库：MySQL =================
# 本机使用已有的 MySQL 8.4.7（Oracle 官方 tarball，路径 ~/mysql/mysql-8.4.7-macos15-arm64）。
# 由 ~/Library/LaunchAgents/com.local.mysql.plist 开机自启，监听 127.0.0.1:3306。
# 客户端在 ~/mysql/mysql-8.4.7-macos15-arm64/bin，已加入 ~/.zprofile 的 PATH。
# root 密码单独存放在 ~/mysql/ROOT_PASSWORD.txt（权限 600），不写入本文件。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ai_growth_ops
MYSQL_USER=ai_ops_user
MYSQL_PASSWORD=replace_with_your_password

# ================= Embedding 与向量库 =================
# bge-small-zh-v1.5：输出 512 维，最大输入 512 token。
# chunk 上限因此限制在 420 汉字，见 docs/00_requirements_and_design.md C-01。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=auto
CHROMA_PATH=data/chroma

# ================= 检索与应用参数 =================
RAG_TOP_K=4
RANDOM_SEED=20261102
